# /etc/systemd/system/mattermost-ssl-auth.service
[Unit]
Description=Mattermost SSL Auth OpenResty
After=network-online.target redis-server.target
Wants=network-online.target
PartOf=mattermost.service

[Service]
Type=forking
ExecStart=/usr/local/openresty/nginx/sbin/nginx -c /usr/local/openresty/nginx/conf/nginx.conf
ExecReload=/usr/local/openresty/nginx/sbin/nginx -c /usr/local/openresty/nginx/conf/nginx.conf -s reload
ExecStop=/usr/local/openresty/nginx/sbin/nginx -c /usr/local/openresty/nginx/conf/nginx.conf -s quit
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# State directories, created by systemd on a fresh install:
#   RuntimeDirectory  /run/openresty        (pid file)
#   LogsDirectory   /var/log/openresty      (error + access logs)
#   StateDirectory  /var/lib/openresty      (nginx temp files)
# Without these the ReadWritePaths= entries below point at missing paths
# and systemd aborts with status=226/NAMESPACE before nginx even starts.
RuntimeDirectory=openresty
LogsDirectory=openresty
StateDirectory=openresty
# ProtectSystem=strict makes the filesystem read-only; nginx can only
# write to these paths (pid + logs + temp files). The temp tree must be
# owned by the worker user (see example/demo_install.sh).
ReadWritePaths=/var/run/openresty /var/log/openresty /var/lib/openresty
EnvironmentFile=/etc/mattermost-ssl-auth.env
# systemd defaults LimitNOFILE=1024, which makes the workers warn "4096
# worker_connections exceed open file resource limit".
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
