# /etc/mattermost-ssl-auth.env — consumed by mattermost-ssl-auth.service
# (chmod 600; contains secrets). Copy to /etc/mattermost-ssl-auth.env
# and adjust for your deployment.

# Base URL of the Mattermost instance behind the proxy.
MATTERMOST_UPSTREAM=http://127.0.0.1:8065

# Public URL of Mattermost (ServiceSettings.SiteURL).
MATTERMOST_SITE_URL=https://mattermost.example.test

# Redis for the session store. Accepted REDIS_URI forms:
# unix:<path>, bare host:port, or redis://host:port.
REDIS_URI=unix:/run/redis/redis-server.sock

# System-admin personal access token used to create Mattermost users.
MATTERMOST_PROVISION_TOKEN=<system-admin personal access token>

# Set to false to disable automatic user creation (auth only).
ALLOW_PROVISION=true

# Team ID new users are added to during provisioning.
MM_DEFAULT_TEAM_ID=<default team id>

# Subject field in the client certificate that holds the user's email.
CERT_EMAIL_FIELD=emailAddress

# Subject field in the client certificate that holds the user's name.
CERT_NAME_FIELD=CN

# Organisation Unit value that grants Mattermost admin rights.
CERT_ADMIN_OU=Admins

# Derive the Mattermost username from the local part of the certificate email.
USERNAME_FROM_EMAIL=true

# Re-establish the cached session once it is older than this (hours),
# before the upstream can kill it.
SESSION_MAX_AGE_HOURS=20
# Proactive renewal re-logs in a session once it is older than this (Mattermost's session TTL is 7+ days by default; 20 h keeps it safely fresh while the user is active).

# Per-user session-health probe throttle; a 401 or over-age session is
# re-established synchronously in the access phase.
SESSION_CHECK_INTERVAL_SECONDS=60
