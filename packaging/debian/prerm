#!/bin/sh
# mattermost-ssl-auth prerm (built by packaging/build_deb.sh).
set -e

case "$1" in
  # Stop before dpkg deletes the package's files: `dpkg --remove` gets
  # `remove`, a direct `dpkg --purge` gets `purge` without a prior
  # remove — either way the unit file goes, and a still-running master
  # would be orphaned and unmanageable.
  remove|purge)
    systemctl stop mattermost-ssl-auth || true
    ;;
  # upgrade / deconfigure: the service keeps running; the unit file is
  # replaced in place and re-registered by postrm.
  upgrade|deconfigure)
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
  *)
    ;;
esac
